---
import Layout from '../../components/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CATEGORIES } from '../../utils/categories';
import { getMergedPosts } from '../../utils/posts';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');

const categoryLabel = CATEGORIES[slug as keyof typeof CATEGORIES];
if (!categoryLabel) return Astro.redirect('/404');

// @ts-ignore
const runtime = Astro.locals.runtime;
const allPosts = await getMergedPosts(runtime?.env);
const categoryPosts = allPosts.filter((post) => post.data.category === slug);
---

<Layout title={`${categoryLabel}のニュース`}>
  <Breadcrumbs items={[{ text: categoryLabel }]} />

  <div class="mb-8 border-b-2 border-navy-dark pb-2">
    <h1 class="text-xl font-bold text-navy-dark flex items-center">
      <span class="w-2 h-6 bg-navy-dark mr-2"></span>
      {categoryLabel}
    </h1>
  </div>

  <div class="space-y-8">
    {categoryPosts.map((post) => (
      <ArticleCard post={post} />
    ))}
  </div>

  {categoryPosts.length === 0 && (
    <p class="text-gray-500 py-10 text-center">このカテゴリーの記事はありません。</p>
  )}
</Layout>
