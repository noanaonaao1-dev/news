---
import Layout from '../../components/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getMergedPosts } from '../../utils/posts';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');

// @ts-ignore
const runtime = Astro.locals.runtime;
const allPosts = await getMergedPosts(runtime?.env);
const tagPosts = allPosts.filter((post) => post.data.tags.includes(slug));
---

<Layout title={`タグ: ${slug}`}>
  <Breadcrumbs items={[{ text: `タグ: ${slug}` }]} />

  <div class="mb-8 border-b-2 border-navy-dark pb-2">
    <h1 class="text-xl font-bold text-navy-dark flex items-center">
      <span class="w-2 h-6 bg-navy-dark mr-2"></span>
      タグ: {slug}
    </h1>
  </div>

  <div class="space-y-8">
    {tagPosts.map((post) => (
      <ArticleCard post={post} />
    ))}
  </div>

  {tagPosts.length === 0 && (
    <p class="text-gray-500 py-10 text-center">このタグの記事はありません。</p>
  )}
</Layout>
