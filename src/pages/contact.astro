---
import Layout from '../components/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---

<Layout title="お問い合わせ">
  <Breadcrumbs items={[{ text: 'お問い合わせ' }]} />

  <article class="prose prose-slate max-w-none">
    <h1 class="text-2xl font-bold text-navy mb-6">お問い合わせ</h1>

    <div class="bg-gray-50 p-6 border border-gray-100 rounded">
      <p class="mb-6 text-sm text-gray-600">
        当サイトへのご意見、情報提供、広告掲載に関するお問い合わせなどは、以下のフォームよりお願いいたします。
        送信ボタンを押すと、お使いのメールアプリが起動します。
      </p>

      <form id="contact-form" class="space-y-4">
        <div>
          <label for="name" class="block text-sm font-bold text-gray-700 mb-1">お名前</label>
          <input type="text" id="name" required class="w-full border border-gray-300 p-2 rounded focus:ring-navy focus:border-navy" placeholder="例：山田 太郎" />
        </div>
        <div>
          <label for="email" class="block text-sm font-bold text-gray-700 mb-1">メールアドレス</label>
          <input type="email" id="email" required class="w-full border border-gray-300 p-2 rounded focus:ring-navy focus:border-navy" placeholder="example@example.com" />
        </div>
        <div>
          <label for="message" class="block text-sm font-bold text-gray-700 mb-1">お問い合わせ内容</label>
          <textarea id="message" required class="w-full border border-gray-300 p-2 rounded h-32 focus:ring-navy focus:border-navy"></textarea>
        </div>
        <button type="submit" class="bg-navy hover:bg-navy-dark text-white font-bold py-2 px-6 rounded transition-colors w-full md:w-auto">
          メールアプリを起動して送信する
        </button>
      </form>
    </div>
  </article>
</Layout>

<script is:inline>
  const form = document.getElementById('contact-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const name = document.getElementById('name').value;
      const email = document.getElementById('email').value;
      const message = document.getElementById('message').value;

      const recipient = 'ooamano1@gmail.com';
      const subject = encodeURIComponent(`【お問い合わせ】芸能フロントライン - ${name}様`);
      const body = encodeURIComponent(
        `お名前: ${name}\n` +
        `メールアドレス: ${email}\n\n` +
        `【お問い合わせ内容】\n${message}`
      );

      window.location.href = `mailto:${recipient}?subject=${subject}&body=${body}`;
    });
  }
</script>
