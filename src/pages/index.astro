---
import Layout from '../components/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getMergedPosts } from '../utils/posts';

export const prerender = false;

// @ts-ignore
const runtime = Astro.locals.runtime;
const sortedPosts = await getMergedPosts(runtime?.env);
---

<Layout isHome={true}>
  <div class="mb-8 border-b-2 border-navy-dark pb-2">
    <h1 class="text-xl font-bold text-navy-dark flex items-center">
      <span class="w-2 h-6 bg-navy-dark mr-2"></span>
      最新ニュース
    </h1>
  </div>

  <div class="space-y-8">
    {sortedPosts.map((post) => (
      <ArticleCard post={post} />
    ))}
  </div>

  {sortedPosts.length === 0 && (
    <p class="text-gray-500 py-10 text-center">記事がありません。</p>
  )}
</Layout>
