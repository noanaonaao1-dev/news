---
import Layout from '../../components/Layout.astro';

let error = '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const password = data.get('password');

    if (password === import.meta.env.ADMIN_PASSWORD || password === process.env.ADMIN_PASSWORD) {
      // シンプルなクッキーによるセッション管理（ユーザーの要望通り）
      Astro.cookies.set('admin_session', 'true', { path: '/', httpOnly: true, secure: true, sameSite: 'strict' });
      return Astro.redirect('/admin');
    } else {
      error = 'パスワードが正しくありません。';
    }
  } catch (e) {
    error = 'エラーが発生しました。';
  }
}
---

<Layout title="管理者ログイン">
  <div class="max-w-md mx-auto my-12 p-8 bg-white border border-gray-200 shadow-sm rounded">
    <h1 class="text-xl font-bold mb-6 text-center text-navy">管理者ログイン</h1>

    {error && <p class="text-red-500 text-sm mb-4">{error}</p>}

    <form method="POST" class="space-y-4">
      <div>
        <label for="password" class="block text-sm font-medium text-gray-700 mb-1">パスワード</label>
        <input
          type="password"
          name="password"
          id="password"
          required
          class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-navy"
        />
      </div>
      <button
        type="submit"
        class="w-full bg-navy text-white py-2 px-4 rounded hover:bg-navy-dark transition-colors"
      >
        ログイン
      </button>
    </form>
  </div>
</Layout>
