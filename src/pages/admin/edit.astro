---
import Layout from '../../components/Layout.astro';
import { isAuthenticated } from '../../utils/auth';
import yaml from 'js-yaml';

if (!isAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

// @ts-ignore
const runtime = Astro.locals.runtime;
const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN || runtime?.env?.GITHUB_TOKEN;
const GITHUB_REPO = import.meta.env.GITHUB_REPO || runtime?.env?.GITHUB_REPO;

const url = new URL(Astro.request.url);
const path = url.searchParams.get('path');
const isEditing = !!path;

let content = '';
let sha = '';
let filename = '';
let message = '';
let error = '';

// 既存記事の読み込み
if (isEditing && GITHUB_TOKEN && GITHUB_REPO) {
  try {
    const response = await fetch(`https://api.github.com/repos/${GITHUB_REPO}/contents/${path}`, {
      headers: {
        'Authorization': `token ${GITHUB_TOKEN}`,
        'Accept': 'application/vnd.github.v3+json',
        'User-Agent': 'Astro-Admin'
      }
    });

    if (response.ok) {
      const data = await response.json();
      // @ts-ignore
      content = Buffer.from(data.content, 'base64').toString('utf-8');
      sha = data.sha;
      filename = data.name.replace('.md', '');
    } else {
      error = '記事の読み込みに失敗しました。';
    }
  } catch (e) {
    error = 'エラーが発生しました。';
  }
}

// 保存処理
if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const formFilename = data.get('filename') as string;
  const formContent = data.get('content') as string;
  const formSha = data.get('sha') as string;

  if (GITHUB_TOKEN && GITHUB_REPO) {
    const filePath = `src/content/posts/${formFilename}.md`;
    const body = {
      message: `Admin: ${isEditing ? 'Update' : 'Create'} ${formFilename}.md`,
      // @ts-ignore
      content: Buffer.from(formContent).toString('base64'),
      sha: formSha || undefined
    };

    try {
      // 1. GitHubに保存
      const response = await fetch(`https://api.github.com/repos/${GITHUB_REPO}/contents/${filePath}`, {
        method: 'PUT',
        headers: {
          'Authorization': `token ${GITHUB_TOKEN}`,
          'Accept': 'application/vnd.github.v3+json',
          'User-Agent': 'Astro-Admin',
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(body)
      });

      if (response.ok) {
        // 2. KVに保存 (即時反映用)
        const kv = runtime?.env?.POSTS_KV;
        if (kv) {
          const match = formContent.match(/^---\n([\s\S]+?)\n---\n([\s\S]*)$/);
          if (match) {
            const frontmatter = yaml.load(match[1]) as any;
            const bodyText = match[2];
            await kv.put(`post:${formFilename}`, JSON.stringify({
              slug: formFilename,
              data: frontmatter,
              body: bodyText
            }));
          }
        }

        message = '保存されました（KVにも反映済み）。';
        if (!isEditing) {
          return Astro.redirect(`/admin/edit?path=${encodeURIComponent(filePath)}&saved=true`);
        }
        const result = await response.json();
        sha = result.content.sha;
        content = formContent;
        filename = formFilename;
      } else {
        const errData = await response.json();
        error = `保存エラー: ${errData.message}`;
      }
    } catch (e) {
      error = '保存中にエラーが発生しました。';
    }
  }
}

if (url.searchParams.get('saved') === 'true') {
  message = '新規記事が作成されました。';
}
---

<Layout title={isEditing ? '記事を編集' : '新規記事作成'}>
  <div class="mb-6">
    <a href="/admin" class="text-sm text-navy hover:underline">← ダッシュボードに戻る</a>
  </div>

  <h1 class="text-2xl font-bold text-navy mb-8">{isEditing ? '記事を編集' : '新規記事作成'}</h1>

  {message && (
    <div class="bg-green-50 border-l-4 border-green-400 p-4 mb-6">
      <p class="text-green-700 text-sm">{message}</p>
    </div>
  )}

  {error && (
    <div class="bg-red-50 border-l-4 border-red-400 p-4 mb-6">
      <p class="text-red-700 text-sm">{error}</p>
    </div>
  )}

  <form method="POST" class="space-y-6">
    <input type="hidden" name="sha" value={sha} />

    <div>
      <label for="filename" class="block text-sm font-medium text-gray-700 mb-1">
        ファイル名 (拡張子なし)
      </label>
      <input
        type="text"
        name="filename"
        id="filename"
        value={filename}
        required
        placeholder="2026-02-14-sample-slug"
        class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-navy"
        {...isEditing ? { readonly: true, class: "w-full px-3 py-2 border border-gray-200 bg-gray-50 rounded text-gray-500 cursor-not-allowed" } : {}}
      />
      <p class="mt-1 text-xs text-gray-400">例: 2026-02-14-title-slug</p>
    </div>

    <div>
      <label for="content" class="block text-sm font-medium text-gray-700 mb-1">
        本文 (Markdown - フロントマターを含む)
      </label>
      <textarea
        name="content"
        id="content"
        rows="30"
        required
        class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-navy font-mono text-sm"
      >{content || `---
title: ""
date: "${new Date().toISOString()}"
category: "actress"
tags: []
author: "編集部"
description: ""
---

`}</textarea>
    </div>

    <div class="flex justify-end">
      <button
        type="submit"
        class="bg-navy text-white py-2 px-8 rounded hover:bg-navy-dark transition-colors font-bold"
      >
        GitHubとKVに保存
      </button>
    </div>
  </form>
</Layout>
