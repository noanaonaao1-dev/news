---
import Layout from '../../components/Layout.astro';
import { isAuthenticated } from '../../utils/auth';

if (!isAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

// @ts-ignore
const runtime = Astro.locals.runtime;
const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN || runtime?.env?.GITHUB_TOKEN || process.env.GITHUB_TOKEN;
const GITHUB_REPO = import.meta.env.GITHUB_REPO || runtime?.env?.GITHUB_REPO || process.env.GITHUB_REPO;
const DEPLOY_HOOK_URL = import.meta.env.DEPLOY_HOOK_URL || runtime?.env?.DEPLOY_HOOK_URL || process.env.DEPLOY_HOOK_URL;

let posts: any[] = [];
let error = '';
let deployMessage = '';

// GitHubから記事一覧を取得
if (GITHUB_TOKEN && GITHUB_REPO) {
  try {
    const response = await fetch(`https://api.github.com/repos/${GITHUB_REPO}/contents/src/content/posts`, {
      headers: {
        'Authorization': `token ${GITHUB_TOKEN}`,
        'Accept': 'application/vnd.github.v3+json',
        'User-Agent': 'Astro-Admin'
      }
    });

    if (response.ok) {
      const data = await response.json();
      posts = data.filter((file: any) => file.name.endsWith('.md')).sort((a: any, b: any) => b.name.localeCompare(a.name));
    } else {
      error = `GitHub APIエラー: ${response.status} ${response.statusText}`;
    }
  } catch (e: any) {
    error = `エラーが発生しました: ${e.message}`;
  }
} else {
  error = 'GITHUB_TOKEN または GITHUB_REPO が設定されていません。';
}

// デプロイボタンの処理
if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const action = data.get('action');

  if (action === 'deploy' && DEPLOY_HOOK_URL) {
    try {
      const resp = await fetch(DEPLOY_HOOK_URL, { method: 'POST' });
      if (resp.ok) {
        deployMessage = 'デプロイが開始されました。完了まで数分かかります。';
      } else {
        deployMessage = 'デプロイフックの呼び出しに失敗しました。';
      }
    } catch (e) {
      deployMessage = 'デプロイエラーが発生しました。';
    }
  }
}
---

<Layout title="管理者ダッシュボード">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-2xl font-bold text-navy">記事管理</h1>
    <div class="flex gap-4">
      <form method="POST">
        <input type="hidden" name="action" value="deploy" />
        <button
          type="submit"
          class="bg-green-600 text-white py-2 px-4 rounded hover:bg-green-700 transition-colors text-sm font-bold"
          onclick="return confirm('本当にデプロイを開始しますか？')"
        >
          🚀 サイトを更新（デプロイ）
        </button>
      </form>
      <a
        href="/admin/edit"
        class="bg-navy text-white py-2 px-4 rounded hover:bg-navy-dark transition-colors text-sm font-bold"
      >
        ＋ 新規記事作成
      </a>
    </div>
  </div>

  <div class="bg-blue-50 border-l-4 border-blue-400 p-4 mb-6">
    <h3 class="text-blue-800 font-bold text-sm mb-1">現在の運用モード: GitHub + Cloudflare KV</h3>
    <p class="text-blue-700 text-xs">
      記事を保存すると GitHub と KV の両方に書き込まれます。KVにより、デプロイを待たずにサイトへ即時反映されます。
    </p>
  </div>

  {deployMessage && (
    <div class="bg-green-50 border-l-4 border-green-400 p-4 mb-6">
      <p class="text-green-700 text-sm">{deployMessage}</p>
    </div>
  )}

  {error && (
    <div class="bg-red-50 border-l-4 border-red-400 p-4 mb-6">
      <p class="text-red-700 text-sm">{error}</p>
    </div>
  )}

  <div class="bg-white border border-gray-200 shadow-sm rounded overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ファイル名</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        {posts.map((post) => (
          <tr>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              {post.name}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <a href={`/admin/edit?path=${encodeURIComponent(post.path)}`} class="text-navy hover:text-navy-dark mr-4">編集</a>
            </td>
          </tr>
        ))}
        {posts.length === 0 && !error && (
          <tr>
            <td colspan="2" class="px-6 py-10 text-center text-gray-500">記事が見つかりません。</td>
          </tr>
        )}
      </tbody>
    </table>
  </div>

  <div class="mt-8 text-center">
    <a href="/admin/api/logout" class="text-xs text-gray-400 hover:underline">ログアウト</a>
  </div>
</Layout>
