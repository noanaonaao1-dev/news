---
import Header from './Header.astro';
import Footer from './Footer.astro';
import Sidebar from './Sidebar.astro';
import Seo from './Seo.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishedDate?: string;
  modifiedDate?: string;
  isHome?: boolean;
}

const { title, description, image, canonical, type, publishedDate, modifiedDate, isHome } = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/icon.jpg" />
    <meta name="generator" content={Astro.generator} />

    <Seo
      title={title}
      description={description}
      image={image}
      canonical={canonical}
      type={type}
      publishedDate={publishedDate}
      modifiedDate={modifiedDate}
      isHome={isHome}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">

    <style is:global>
      body {
        font-family: 'Noto Sans JP', sans-serif;
      }
    </style>
  </head>
  <body class="bg-gray-50 flex flex-col min-h-screen">
    <Header />

    <main class="container mx-auto px-4 py-8 flex-grow">
      <div class="flex flex-col lg:flex-row gap-8">
        <div class="w-full lg:w-2/3 bg-white p-4 md:p-8 border border-gray-100 shadow-sm">
          <slot />
        </div>

        <div class="w-full lg:w-1/3">
          <Sidebar />
        </div>
      </div>
    </main>

    <Footer />

    <!-- Monetag Scripts -->
    <script is:inline>(function(s){s.dataset.zone='10606549',s.src='https://gizokraijaw.net/vignette.min.js'})([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')))</script>
    <script is:inline>(function(s){s.dataset.zone='10606570',s.src='https://nap5k.com/tag.min.js'})([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')))</script>

    <!-- SNS Embed Scripts -->
    <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
    <script async src="//www.instagram.com/embed.js"></script>
  </body>
</html>
