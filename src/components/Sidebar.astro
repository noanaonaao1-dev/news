---
import { CATEGORIES } from '../utils/categories';
---

<aside class="space-y-10">
  <!-- Categories Section -->
  <div>
    <h3 class="text-sm font-bold text-white bg-navy-dark px-3 py-1.5 mb-4 inline-block">カテゴリー</h3>
    <ul class="border-t border-gray-100">
      {Object.entries(CATEGORIES).map(([key, label]) => (
        <li class="border-b border-gray-100">
          <a href={`/category/${key}`} class="flex justify-between items-center py-2.5 text-sm text-gray-700 hover:text-navy hover:bg-gray-50 transition-colors px-1">
            <span>{label}</span>
            <span class="text-gray-300">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- About Section -->
  <div class="bg-gray-50 p-4 border border-gray-100">
    <h3 class="text-sm font-bold text-navy mb-2">芸能フロントラインについて</h3>
    <p class="text-[11px] text-gray-600 leading-relaxed">
      当サイトは、エンタメ業界の最新動向を正確かつ迅速にお伝えする芸能ニュースメディアです。編集部一同、信頼性の高い情報発信を心がけています。
    </p>
  </div>
</aside>
