---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES } from '../utils/categories';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { slug, data } = post;
const categoryLabel = CATEGORIES[data.category as keyof typeof CATEGORIES];

const formattedDate = new Date(data.date).toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<article class="flex gap-4 group">
  <a href={`/post/${slug}`} class="flex-shrink-0 w-24 h-24 md:w-32 md:h-32 overflow-hidden bg-gray-100 border border-gray-100">
    <img
      src={data.image}
      alt={data.title}
      width="128"
      height="128"
      loading="lazy"
      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </a>
  <div class="flex flex-col justify-center">
    <div class="flex items-center gap-2 mb-1">
      <span class="text-[10px] font-bold text-white bg-navy px-1.5 py-0.5 rounded uppercase">
        {categoryLabel}
      </span>
      <time datetime={data.date.toISOString()} class="text-xs text-gray-500">
        {formattedDate}
      </time>
    </div>
    <h2 class="text-base md:text-lg font-bold leading-snug line-clamp-2 group-hover:text-navy transition-colors">
      <a href={`/post/${slug}`}>
        {data.title}
      </a>
    </h2>
    <div class="mt-1 text-xs text-gray-400">
      {data.author}
    </div>
  </div>
</article>
