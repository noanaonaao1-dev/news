---
interface Props {
  id?: string;
  className?: string;
}

const { id = "monetag-ad", className = "" } = Astro.props;
---

<div class={`ad-slot my-8 flex flex-col items-center overflow-hidden ${className}`}>
  <div class="text-[10px] text-gray-400 mb-1">スポンサーリンク</div>
  <div
    class="bg-gray-100 border border-gray-200 flex items-center justify-center text-gray-400"
    style="width: 300px; height: 250px;"
  >
    <!-- Monetag Tag Placeholder -->
    <!-- <script src="https://alwingulla.com/88/tag.min.js" data-zone="YOUR_ZONE_ID" async data-cfasync="false"></script> -->
    <div class="text-sm">Advertisement</div>
  </div>
</div>

<style>
  /* Base styles to prevent CLS */
  .ad-slot {
    min-height: 280px;
  }
</style>
